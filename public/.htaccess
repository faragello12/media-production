# SPA routing: serve index.html for any path that isn't a real file
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Force https and the bare domain (no www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Build assets have hashed names, so they never change; cache them for a year
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpe?g|webp|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Root files (icons, share image) keep fixed names; cache for a week
  <FilesMatch "^(favicon\.(ico|svg)|apple-touch-icon\.png|icon-\d+\.png|og-image\.jpg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
